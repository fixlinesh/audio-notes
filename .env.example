# Public (browser) — Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only (Vercel → Settings → Environment Variables). Never prefix with VITE_.
GEMINI_API_KEY=your-gemini-key
# Optional: change the model without touching code
GEMINI_MODEL=gemini-3.5-flash-lite
